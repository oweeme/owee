c Teclado Owee 1.0 para Keyman. Generado por generar_keyman.py: no editar a mano.
c Escribe en romano y obtiene Owee Script (glifos en la zona privada U+E000..E049).
store(&VERSION) '17.0'
store(&NAME) 'Owee'
store(&KEYBOARDVERSION) '1.0'
store(&COPYRIGHT) '(c) 2026 Hector Martinez - MIT'
store(&MESSAGE) 'Escribe en romano: suna -> glifos Owee. Guion para compuestos, Mayuscula para nombres, AltGr+cifra para cifras normales.'
store(&TARGETS) 'any'
store(&LAYOUTFILE) 'owee.keyman-touch-layout'

begin Unicode > use(main)
store(glifos) U+E000 .. U+E03B

group(main) using keys

c --- cifras: 0-9 -> glifos numericos; AltGr + cifra -> cifra normal
+ [RALT K_0] > '0'
+ '0' > U+E040
+ [RALT K_1] > '1'
+ '1' > U+E041
+ [RALT K_2] > '2'
+ '2' > U+E042
+ [RALT K_3] > '3'
+ '3' > U+E043
+ [RALT K_4] > '4'
+ '4' > U+E044
+ [RALT K_5] > '5'
+ '5' > U+E045
+ [RALT K_6] > '6'
+ '6' > U+E046
+ [RALT K_7] > '7'
+ '7' > U+E047
+ [RALT K_8] > '8'
+ '8' > U+E048
+ [RALT K_9] > '9'
+ '9' > U+E049

c --- sh y ch (minuscula y mayuscula inicial)
's' + 'h' > 'sh'
'S' + 'h' > 'Sh'
'c' + 'h' > 'ch'
'C' + 'h' > 'Ch'

c --- silabas: consonante + vocal -> glifo; con mayuscula inicial -> marca de nombre + glifo
'p' + 'a' > U+E004
'P' + 'a' > U+E03D U+E004
'p' + 'e' > U+E005
'P' + 'e' > U+E03D U+E005
